@page "/app/chat/{ChatId:long}"
@layout BlazorApp1.Shared.AppShellLayout

@using DTOs.ChatDTOs
@using DTOs.UserDTOs
@using DTOs.UserActionRequests
@inject BlazorApp1.Service.Api.IChatApi ChatApi
@inject BlazorApp1.Service.Api.IUserApi UserApi
@inject BlazorApp1.Service.AuthSession Session
@inject BlazorApp1.Service.ChatStore ChatStore
@inject NavigationManager Nav

<div class="chat-root">

    <div class="chat-top d-flex align-items-center justify-content-between">
        <a class="text-decoration-none text-reset" href="@($"/app/chat/{ChatId}/info")">
            <h4 class="m-0">@_headerText</h4>
        </a>

        @if (_selectionMode)
        {
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-secondary">Selected: @_selectedIds.Count</span>

                <button type="button"
                        class="btn btn-sm btn-outline-danger"
                        disabled="@(_bulkBusy || _selectedIds.Count == 0)"
                        @onclick="OpenBulkDeleteConfirm">
                    Delete selected
                </button>

                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        @onclick="ExitSelectionMode">
                    Cancel
                </button>
            </div>
        }
    </div>

   <div class="chat-scroll" id="chatMessages">
    <div class="chat-scroll-inner">
        @if (_loading)
        {
            <div class="text-muted mt-3">Loading…</div>
        }
        else if (_messages.Count == 0)
        {
            <div class="text-muted mt-3">No messages yet.</div>
        }
        else
        {
            @foreach (var m in _messages.OrderBy(x => x.SentAt))
            {
                var isMine = IsMine(m);
                var isSelected = _selectedIds.Contains(m.Id);

                <div class="d-flex mb-2 @(isMine ? "justify-content-end" : "justify-content-start")">
                    @if (_selectionMode && isMine)
                    {
                        <input class="form-check-input me-2 mt-2"
                               type="checkbox"
                               checked="@isSelected"
                               @onclick:stopPropagation="true"
                               @onchange="_ => ToggleSelected(m)" />
                    }

                    <div class="message-bubble @(isMine ? "message-mine" : "message-other") @(isSelected ? "message-selected" : "")"
                         role="button"
                         title="Click for actions"
                         @onclick="() => OnMessageClicked(m)">

                        @if (!isMine)
                        {
                            <div class="small fw-semibold mb-1">@GetDisplayName(m.SenderId)</div>
                        }

                        <div style="white-space: pre-wrap;">@m.Text</div>

                        <div class="d-flex justify-content-end align-items-center gap-2 mt-1">
                            @if (m.EditedAt is not null)
                            {
                                <span class="text-muted small">(edited)</span>
                            }
                            <span class="text-muted small">@m.SentAt.ToLocalTime().ToString("HH:mm")</span>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>


    <div class="chat-bottom">
        <div class="d-flex gap-2">
            <input class="form-control"
                   placeholder="Type a message..."
                   @bind="_text"
                   @bind:event="oninput" />

            <button type="button"
                    class="btn btn-primary"
                    @onclick="SendAsync"
                    disabled="@(_sending || string.IsNullOrWhiteSpace(_text))">
                @(_sending ? "Sending..." : "Send")
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_status))
        {
            <div class="text-muted mt-2">@_status</div>
        }
    </div>

</div>

@* ---------- Message action modal ---------- *@
@if (_modalOpen)
{
    <div class="modal fade show d-block chat-modal" tabindex="-1" style="background: rgba(0,0,0,.55);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Message</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>

                <div class="modal-body">
                    @if (_active is null)
                    {
                        <div class="text-muted">No message selected.</div>
                    }
                    else
                    {
                        @if (_modalMode != ModalMode.ConfirmDeleteMany)
                        {
                            <div class="small text-muted mb-2">
                                <div><b>From:</b> @GetDisplayName(_active.SenderId)</div>
                                <div><b>Time:</b> @_active.SentAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                            </div>
                        }

                        @if (_modalMode == ModalMode.View)
                        {
                            <div class="border rounded p-2" style="white-space: pre-wrap;">@_active.Text</div>
                        }
                        else if (_modalMode == ModalMode.Edit)
                        {
                            <label class="form-label">Edit message</label>
                            <textarea class="form-control" rows="4" @bind="_editText"></textarea>
                        }
                        else if (_modalMode == ModalMode.ConfirmDeleteOne)
                        {
                            <div class="alert alert-warning mb-0">
                                Delete this message?
                            </div>

                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" id="delAll1" @bind="_deleteForAll" />
                                <label class="form-check-label" for="delAll1">
                                    Delete for everyone
                                </label>
                            </div>
                        }
                        else if (_modalMode == ModalMode.ConfirmDeleteMany)
                        {
                            <div class="alert alert-warning mb-0">
                                Delete <b>@_selectedIds.Count</b> selected messages?
                            </div>

                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" id="delAllMany" @bind="_deleteForAll" />
                                <label class="form-check-label" for="delAllMany">
                                    Delete for everyone
                                </label>
                            </div>
                        }
                    }

                    @if (!string.IsNullOrWhiteSpace(_modalError))
                    {
                        <div class="text-danger small mt-2">@_modalError</div>
                    }
                </div>

                <div class="modal-footer">
                    @if (_active is null)
                    {
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Close</button>
                    }
                    else
                    {
                        @switch (_modalMode)
                        {
                            case ModalMode.View:
                                @* Edit/Delete только для своих сообщений *@
                                @if (_canModifyActive)
                                {
                                    <button type="button" class="btn btn-outline-secondary" @onclick="EnterSelectionModeFromModal">
                                        Select multiple
                                    </button>

                                    <button type="button"
                                            class="btn btn-outline-primary"
                                            disabled="@_modalBusy"
                                            @onclick="StartEdit">
                                        Edit
                                    </button>

                                    <button type="button"
                                            class="btn btn-outline-danger"
                                            disabled="@_modalBusy"
                                            @onclick="AskDeleteOne">
                                        Delete
                                    </button>
                                }

                                <button type="button" class="btn btn-secondary" @onclick="CloseModal">Close</button>
                                break;

                            case ModalMode.Edit:
                                <button type="button"
                                        class="btn btn-primary"
                                        disabled="@(_modalBusy || string.IsNullOrWhiteSpace(_editText))"
                                        @onclick="SaveEditAsync">
                                    @(_modalBusy ? "Saving..." : "Save")
                                </button>
                                <button type="button" class="btn btn-secondary" disabled="@_modalBusy" @onclick="CancelEdit">
                                    Cancel
                                </button>
                                break;

                            case ModalMode.ConfirmDeleteOne:
                                <button type="button" class="btn btn-danger" disabled="@_modalBusy" @onclick="DeleteOneAsync">
                                    @(_modalBusy ? "Deleting..." : "Delete")
                                </button>
                                <button type="button" class="btn btn-secondary" disabled="@_modalBusy" @onclick="BackToView">
                                    Cancel
                                </button>
                                break;

                            case ModalMode.ConfirmDeleteMany:
                                <button type="button"
                                        class="btn btn-danger"
                                        disabled="@(_modalBusy || _selectedIds.Count == 0)"
                                        @onclick="DeleteSelectedAsync">
                                    @(_modalBusy ? "Deleting..." : "Delete selected")
                                </button>
                                <button type="button" class="btn btn-secondary" disabled="@_modalBusy" @onclick="BackToView">
                                    Cancel
                                </button>
                                break;
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

<style>
    .app-shell {
        height: 100vh;
        overflow: hidden;
    }
    .chat-scroll {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
    }

    .chat-scroll-inner {
        min-height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: flex-end; /* прижать к низу */
    }


    .app-shell > main.main {
        height: 100vh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .chat-root {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        padding: 0;
    }

    .chat-top {
        flex: 0 0 auto;
        padding: 10px 0 12px 0;
    }

    .chat-scroll {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        padding-right: 6px;
        padding-bottom: 12px;
    }

    .chat-bottom {
        flex: 0 0 auto;
        padding: 10px 0 0 0;
        background: rgba(10, 14, 22, 0.85);
        backdrop-filter: blur(6px);
        border-top: 1px solid rgba(255,255,255,.08);
    }

    /* message bubble */
    .message-bubble {
        max-width: 70%;
        padding: .5rem .75rem;
        border-radius: .9rem;
        border: 1px solid rgba(0,0,0,.08);
        background: rgba(0,0,0,.02);
    }

    .message-mine {
        border-color: rgba(13,110,253,.25);
        background: rgba(13,110,253,.10);
    }

    .message-other {
        border-color: rgba(13,110,253,.25);
        background: rgba(13,110,253,.10);
    }

    .message-selected {
        outline: 2px solid rgba(13,110,253,.35);
        outline-offset: 2px;
    }

    /* ---------- nicer modal theme ---------- */
    .chat-modal .modal-content {
        background: rgba(18, 23, 33, 0.96);
        color: rgba(235, 240, 250, 0.95);
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 16px;
        box-shadow: 0 18px 50px rgba(0,0,0,.55);
    }

    .chat-modal .modal-header,
    .chat-modal .modal-footer {
        border-color: rgba(255,255,255,.10);
        background: rgba(255,255,255,.03);
    }

    .chat-modal .btn-close {
        filter: invert(1);
        opacity: .75;
    }
    .chat-modal .btn-close:hover { opacity: 1; }

    .chat-modal .form-control,
    .chat-modal textarea {
        background: rgba(255,255,255,.06);
        color: rgba(235, 240, 250, 0.95);
        border: 1px solid rgba(255,255,255,.10);
    }
    .chat-modal .form-control:focus,
    .chat-modal textarea:focus {
        border-color: rgba(13,110,253,.55);
        box-shadow: 0 0 0 .2rem rgba(13,110,253,.15);
    }

    .chat-modal .alert {
        background: rgba(255, 193, 7, .10);
        border: 1px solid rgba(255, 193, 7, .20);
        color: rgba(235, 240, 250, 0.92);
    }
</style>

@code {
    [Parameter] public long ChatId { get; set; }

    private bool _loading = true;
    private bool _sending;
    private string _text = "";
    private string? _status;

    private long _loadedChatId;
    private readonly List<MessageDTO> _messages = new();

    private readonly Dictionary<long, UserDTO> _usersById = new();

    private string _headerText = "";
    private long _headerForChatId;

    private bool _selectionMode;
    private readonly HashSet<string> _selectedIds = new();
    private bool _bulkBusy;

    private bool _modalOpen;
    private MessageDTO? _active;
    private ModalMode _modalMode = ModalMode.View;
    private bool _modalBusy;
    private string? _modalError;
    private string _editText = "";
    private bool _canModifyActive;

    private bool _deleteForAll = true;

    private enum ModalMode
    {
        View,
        Edit,
        ConfirmDeleteOne,
        ConfirmDeleteMany
    }

    protected override Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
            Nav.NavigateTo("/login");

        return Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!Session.IsAuthenticated || ChatId <= 0) return;

        if (_loadedChatId != ChatId)
        {
            _loadedChatId = ChatId;
            ExitSelectionMode();

            _headerText = $"Chat #{ChatId}";
            await ResolveHeaderAsync();

            await LoadMessagesAsync();
        }
        else
        {
            await ResolveHeaderAsync();
        }
    }

    private async Task ResolveHeaderAsync()
    {
        if (_headerForChatId == ChatId && !string.IsNullOrWhiteSpace(_headerText))
            return;

        _headerForChatId = ChatId;

        var chat = ChatStore.Chats.FirstOrDefault(c => c.Id == ChatId);

        if (chat is null)
        {
            try
            {
                await ChatStore.RefreshAsync();
                chat = ChatStore.Chats.FirstOrDefault(c => c.Id == ChatId);
            }
            catch { }
        }

        if (chat is null)
        {
            _headerText = $"Chat #{ChatId}";
            return;
        }

        var type = (chat.Type?.ToString() ?? "").Trim().ToUpperInvariant();

        if (type == "GROUP")
        {
            _headerText = string.IsNullOrWhiteSpace(chat.Title) ? $"Group #{ChatId}" : chat.Title!;
            return;
        }

        try
        {
            var members = await ChatApi.GetMembersAsync(ChatId);
            var otherId = members.Select(m => m.UserId).FirstOrDefault(id => id > 0 && id != Session.UserId);

            if (otherId > 0)
            {
                await WarmupUsersAsync(new List<long> { otherId });
                _headerText = GetDisplayName(otherId);
                return;
            }
        }
        catch { }

        _headerText = string.IsNullOrWhiteSpace(chat.Title) ? "Direct" : chat.Title!;
    }

    private async Task LoadMessagesAsync()
    {
        _loading = true;
        _status = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var msgs = await ChatApi.GetMessagesAsync(ChatId);

            _messages.Clear();
            _messages.AddRange(msgs);

            var existing = _messages.Select(m => m.Id).ToHashSet();
            _selectedIds.RemoveWhere(id => !existing.Contains(id));

            var senderIds = _messages.Select(m => m.SenderId).Where(id => id > 0).Distinct().ToList();
            await WarmupUsersAsync(senderIds);
        }
        catch (Exception ex)
        {
            _messages.Clear();
            _status = ex.Message;
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task WarmupUsersAsync(List<long> userIds)
    {
        var missing = userIds.Where(id => !_usersById.ContainsKey(id)).ToList();
        if (missing.Count == 0) return;

        var tasks = missing.Select(async id =>
        {
            try
            {
                var u = await UserApi.GetByIdAsync(id);
                if (u != null) _usersById[id] = u;
            }
            catch { }
        });

        await Task.WhenAll(tasks);
    }

    private string GetDisplayName(long userId)
    {
        if (userId == Session.UserId)
            return string.IsNullOrWhiteSpace(Session.DisplayName) ? (Session.Username ?? "me") : Session.DisplayName;

        if (_usersById.TryGetValue(userId, out var u))
            return string.IsNullOrWhiteSpace(u.DisplayName) ? u.Username : u.DisplayName;

        return $"User {userId}";
    }

    private async Task SendAsync()
    {
        if (_sending) return;

        var text = (_text ?? "").Trim();
        if (string.IsNullOrWhiteSpace(text)) return;

        _sending = true;
        _status = null;

        try
        {
            var req = new SendMessageRequest
            {
                ChatId = ChatId,
                SenderId = Session.UserId,
                TextContent = text
            };

            await ChatApi.SendMessageAsync(req);

            _text = "";
            await LoadMessagesAsync();
        }
        catch (Exception ex)
        {
            _status = ex.Message;
        }
        finally
        {
            _sending = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnMessageClicked(MessageDTO m)
    {
        if (_selectionMode)
        {
            if (IsMine(m)) ToggleSelected(m);
            return;
        }

        OpenModal(m);
    }

    private void ToggleSelected(MessageDTO m)
    {
        if (!IsMine(m)) return;

        if (_selectedIds.Contains(m.Id))
            _selectedIds.Remove(m.Id);
        else
            _selectedIds.Add(m.Id);
    }

    private bool IsMine(MessageDTO m) => m.SenderId == Session.UserId;

    private void EnterSelectionModeFromModal()
    {
        if (_active is null) return;
        if (!IsMine(_active)) return;

        _selectionMode = true;
        _selectedIds.Clear();
        _selectedIds.Add(_active.Id);

        CloseModal();
    }

    private void ExitSelectionMode()
    {
        _selectionMode = false;
        _selectedIds.Clear();
        _bulkBusy = false;
    }

    private void OpenModal(MessageDTO m)
    {
        _active = m;
        _modalOpen = true;
        _modalBusy = false;
        _modalError = null;
        _modalMode = ModalMode.View;
        _editText = m.Text ?? "";
        _canModifyActive = IsMine(m);
        _deleteForAll = true;
    }

    private void CloseModal()
    {
        _modalOpen = false;
        _active = null;
        _modalBusy = false;
        _modalError = null;
        _modalMode = ModalMode.View;
        _editText = "";
        _canModifyActive = false;
        _deleteForAll = true;
    }

    private void StartEdit()
    {
        if (_active is null) return;
        if (!_canModifyActive) return;

        _modalError = null;
        _editText = _active.Text ?? "";
        _modalMode = ModalMode.Edit;
    }

    private void CancelEdit()
    {
        _modalError = null;
        _modalMode = ModalMode.View;
    }

    private void BackToView()
    {
        _modalError = null;
        _modalMode = ModalMode.View;
    }

    private void AskDeleteOne()
    {
        if (_active is null) return;
        if (!_canModifyActive) return;

        _modalError = null;
        _deleteForAll = true;
        _modalMode = ModalMode.ConfirmDeleteOne;
    }

    private void OpenBulkDeleteConfirm()
    {
        if (!_selectionMode)
            _selectionMode = true;

        _modalOpen = true;
        _modalBusy = false;
        _modalError = null;
        _modalMode = ModalMode.ConfirmDeleteMany;
        _active = _messages.FirstOrDefault();
        _canModifyActive = true;
        _deleteForAll = true;
    }

    private async Task SaveEditAsync()
    {
        if (_active is null) return;
        if (!_canModifyActive) return;

        var newText = (_editText ?? "").Trim();
        if (newText.Length == 0)
        {
            _modalError = "Message cannot be empty.";
            return;
        }

        _modalBusy = true;
        _modalError = null;

        try
        {
            await ChatApi.EditMessageAsync(_active.Id, newText);
            await LoadMessagesAsync();
            CloseModal();
        }
        catch (Exception ex)
        {
            _modalError = ex.Message;
        }
        finally
        {
            _modalBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task DeleteOneAsync()
    {
        if (_active is null) return;
        if (!_canModifyActive) return;

        _modalBusy = true;
        _modalError = null;

        try
        {
            await ChatApi.DeleteMessageAsync(_active.Id, ChatId, _deleteForAll);
            await LoadMessagesAsync();
            CloseModal();
        }
        catch (Exception ex)
        {
            _modalError = ex.Message;
        }
        finally
        {
            _modalBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task DeleteSelectedAsync()
    {
        if (_selectedIds.Count == 0) return;

        _modalBusy = true;
        _modalError = null;
        _bulkBusy = true;

        try
        {
            await ChatApi.DeleteMessagesAsync(_selectedIds.ToList(), ChatId, _deleteForAll);

            ExitSelectionMode();
            await LoadMessagesAsync();
            CloseModal();
        }
        catch (Exception ex)
        {
            _modalError = ex.Message;
        }
        finally
        {
            _bulkBusy = false;
            _modalBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
