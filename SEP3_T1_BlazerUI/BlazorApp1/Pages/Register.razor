@page "/register"

@using DTOs.UserActionRequests
@inject BlazorApp1.Service.Api.IAuthApi AuthApi
@inject NavigationManager Nav

<h3>Register</h3>

<EditForm Model="_model" OnValidSubmit="Submit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Username</label>
        <InputText class="form-control" @bind-Value="_model.Username" />
    </div>

    <div class="mb-3">
        <label class="form-label">Display name</label>
        <InputText class="form-control" @bind-Value="_model.DisplayName" />
    </div>

    <div class="mb-3">
        <label class="form-label">Password</label>
        <InputText class="form-control" @bind-Value="_model.Password" type="password" />
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (!string.IsNullOrWhiteSpace(_success))
    {
        <div class="alert alert-success">@_success</div>
    }

    <button class="btn btn-primary w-100" type="submit" disabled="@_loading">
        @(_loading ? "Creating..." : "Create account")
    </button>

    <div class="mt-3 text-center">
        <a href="/login">Back to login</a>
    </div>
</EditForm>

@code {
    private RegisterModel _model = new();
    private string? _error;
    private string? _success;
    private bool _loading;

    private async Task Submit()
    {
        _error = null;
        _success = null;
        _loading = true;

        try
        {
            var username = (_model.Username ?? "").Trim();
            var displayName = (_model.DisplayName ?? "").Trim();

            var req = new RegisterUserRequest
            {
                Username = username,
                Password = _model.Password ?? "",
                DisplayName = displayName,
                Phone = "",
                AvatarUrl = ""
            };

            await AuthApi.RegisterAsync(req);

            _success = "Registered successfully. You can log in now.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    public sealed class RegisterModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string? Username { get; set; }

        public string? DisplayName { get; set; }

        [System.ComponentModel.DataAnnotations.Required]
        public string? Password { get; set; }
    }
}
